<?xml version="1.0" encoding="UTF-8"?>
<phpunit bootstrap="vendor/autoload.php"
         colors="true"
         cacheDirectory=".phpunit.cache">
    <testsuites>
        <testsuite name="default">
            <directory>tests</directory>
            <exclude>tests/Unit/Function</exclude>
            <exclude>tests/Unit/Value</exclude>
            <exclude>tests/Feature/Function</exclude>
            <exclude>tests/Feature/Value</exclude>
        </testsuite>
    </testsuites>
</phpunit>
